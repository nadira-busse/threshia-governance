# LLM Provider — "mistral" or "openai", both fully implemented
THRESHIA_PROVIDER=mistral

# Mistral configuration
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenAI configuration (alternative provider — set THRESHIA_PROVIDER=openai to use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: directory for generated ChromaDB index and audit log
# Defaults to the current working directory when unset.
THRESHIA_RUNTIME_DIR=
